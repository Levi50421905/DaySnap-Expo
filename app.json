{
  "expo": {
    "name": "daysnap-expo",
    "slug": "daysnap-expo",
    "scheme": "daysnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.levialfrz.daysnap",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Daysnap butuh akses galeri untuk upload foto harian kamu."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Daysnap butuh lokasi untuk menentukan area rumah kamu (dipakai untuk fitur Discovery Context)."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f7f61466-2aa5-488c-91b8-6af8728d141c"
      }
    }
  }
}